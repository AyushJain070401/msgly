{
  "name": "@msgly/smtp",
  "version": "0.9.0",
  "description": "SMTP + IMAP adapter for Msgly — works with Yahoo, Zoho, Fastmail, or any custom mail server",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@msgly/core": "workspace:*",
    "imapflow": "^1.0.164",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AyushJain070401/msgly.git",
    "directory": "packages/adapter-smtp"
  },
  "keywords": [
    "smtp",
    "imap",
    "email",
    "yahoo",
    "zoho",
    "fastmail",
    "messaging"
  ]
}
